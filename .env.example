# Databáze (Supabase Postgres). Skutečné hodnoty patří jen do .env.local, nikdy do gitu.
# Pooler (transaction mode), port 6543 - runtime aplikace
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Přímé spojení, port 5432 - migrace (drizzle-kit)
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase Auth (veřejné hodnoty projektu)
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role - jen server, nikdy do klienta
SUPABASE_SERVICE_ROLE_KEY=

# E-mail (Resend)
RESEND_API_KEY=
EMAIL_FROM=tickets@example.com
# resend | outbox (outbox = zápis do .e2e-outbox/ pro e2e a lokální vývoj)
EMAIL_DRIVER=resend

# E-mail prvního platform admina (seed)
PLATFORM_ADMIN_EMAIL=admin@example.com
# Heslo seed admina (volitelné, jen lokálně)
SEED_ADMIN_PASSWORD=

# Veřejná URL aplikace (odkazy v e-mailech)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CI / lint / build: 1 = přeskočí validaci env
# SKIP_ENV_VALIDATION=1

# E2E (jen pro lokalni e2e; vychozi je PLATFORM_ADMIN_EMAIL / SEED_ADMIN_PASSWORD)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
