{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.env.local)",
      "Bash(cat .env*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3 .claude/hooks/token_tracker.py" } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "python3 .claude/hooks/token_tracker.py" } ] }
    ]
  }
}
